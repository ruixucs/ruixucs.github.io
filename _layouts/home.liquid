<!doctype html>
{%- comment -%}
  Single-page homepage (used by _pages/about.md). Profile, links and sections are
  configured in _data/homepage/settings.yml; the bio is the page content.
{%- endcomment -%}
{%- assign settings = site.data.homepage.settings -%}
{%- assign photo_base = settings.photo | remove: '.jpg' | remove: '.jpeg' | remove: '.png' -%}
<html lang="{{ site.lang }}">
  <head>
    {% include home/head.liquid %}
  </head>
  <body class="home">
    <main class="page">
      <section class="profile" id="about" aria-label="About">
        {% if settings.photo %}
          <div class="profile__photo">
            <picture>
              {% if site.imagemagick.enabled %}
                <source
                  type="image/webp"
                  srcset="{% for width in site.imagemagick.widths %}{{ photo_base | relative_url }}-{{ width }}.webp {{ width }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
                  sizes="(max-width: 760px) 80vw, 280px"
                >
              {% endif %}
              <img
                src="{{ settings.photo | relative_url }}"
                alt="{{ settings.photo_alt | escape }}"
                onerror="this.onerror=null;var s=this.parentNode.querySelector('source');if(s){s.parentNode.removeChild(s);}"
              >
            </picture>
          </div>
        {% endif %}
        <div class="profile__intro">
          <h1 class="profile__name">{{ settings.name }}</h1>
          {% if settings.email %}
            <p class="profile__email">{{ settings.email }}</p>
          {% endif %}
          <div class="profile__bio">
            {{ content }}
          </div>
          {% if settings.links %}
            <p class="profile__links">
              {%- for link in settings.links -%}
                <a href="{{ link.url | relative_url }}">{{ link.label }}</a>
                {%- unless forloop.last -%}
                  <span class="sep" aria-hidden="true">/</span>
                {%- endunless -%}
              {%- endfor -%}
            </p>
          {% endif %}
        </div>
      </section>

      {% for section in settings.sections %}
        {% if section.show %}
          {% include home/{{ section.id }}.liquid section=section %}
        {% endif %}
      {% endfor %}
    </main>

    {% include home/footer.liquid %}
    {% include home/robot.liquid %}
    <script src="{{ '/assets/js/home.js' | relative_url | bust_file_cache }}" defer></script>
  </body>
</html>
